soong_config_module_type {
    name: "audiohal_libs_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "libaudiohalvendorextn",
    bool_variables: ["HALADAPT_AIDL_ANDROID_VREL2"],
    properties: ["shared_libs"],
}

audiohal_libs_cc_defaults {
    name: "audiohal_libs_defaults",
    soong_config_variables: {
        HALADAPT_AIDL_ANDROID_VREL2: {
            shared_libs: ["av-audio-types-aidl-ndk",],
            conditions_default: {
                shared_libs: ["av-audio-types-aidl-V1-ndk",],
            },
       },
    }
}

cc_defaults {
      name: "AudiohalDefaults",
      defaults: ["audiohal_libs_defaults"],
}

aidl_interface {
    name: "qti-audio-types-aidl",
    stability: "vintf",
    owner: "qcom",
    system_ext_specific: true,
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/qti/audio/core/VString.aidl",
    ],
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },

    ],
    frozen: true,
}

cc_library {
    name: "libaudiohalvendorextn",
    defaults: ["AudiohalDefaults"],
    system_ext_specific: true,
    srcs: ["HalAdapterVendorExtension.cpp"],

    export_include_dirs: [
        "include",
    ],

    header_libs: [
        "libsystem_headers",
    ],

    shared_libs: [
        "libbinder_ndk",
        "libbase",
        "qti-audio-types-aidl-V1-ndk",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wthread-safety",
        "-DBACKEND_NDK",
    ],
}
